# =============================================
# case-intelligence 飞书 Bot · 环境变量模板
#
# 用法：复制为 .env 并填入真实值（.env 不入公开渠道；真实密钥严禁提交，AGENTS §6.2）
# 本文件**只放占位符**，任何真实凭证不得出现在仓库中（SPEC-feishu-bot §11）。
# =============================================

# ---- 必填：飞书自建应用凭证（独立 app，不复用 court / litigation 的凭证）----
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 通道：websocket（默认，无需公网 IP/域名）| webhook（需公网可达入口）----
LARK_CONNECTION_MODE=websocket
# 仅 webhook 模式需要：
LARK_VERIFY_TOKEN=
LARK_ENCRYPT_KEY=

# ---- 身份与角色（SPEC §8）----
# 白名单：open_id:role,open_id:role ...（role ∈ readonly|writer|generator|admin）
LARK_ROLE_MAP=
# 白名单外默认角色（缺省 readonly）；设为 deny 则白名单外一律拒绝
LARK_DEFAULT_ROLE=readonly
LARK_UNKNOWN_ROLE_POLICY=readonly
# 群聊是否必须 @Bot 才响应（1=必须，0=不限制）
LARK_REQUIRE_MENTION=1
# 角色映射文件目录（缺省 <module>/.run/bot；roles.json 可热改）
LARK_STATE_DIR=

# ---- Bot 行为 ----
LARK_BOT_NAME=案小智
# 提取/生成引擎（minimax|ollama|openai|basic|mock）
LARK_BOT_ENGINE=minimax
# 附件落盘目录（缺省 <module>/.run/bot/intake，已 gitignore；禁止指向 data/）
LARK_INTAKE_DIR=

# ---- 会话记忆（C：指代补全，SPEC §5.3）----
# 0=关闭（不落 sessions.json，不解析「它/这个」）
LARK_MEMORY_ENABLED=1

# ---- A：LLM 兜底意图（规则未命中才调用，SPEC §5.4）----
# 0=关闭（规则未命中直接回引导卡）
LARK_LLM_FALLBACK=1
# 使用的引擎名（须在 ai_engines.yaml 中已注册；缺省 minimax）
LARK_LLM_ENGINE=minimax
LARK_LLM_MAX_TOKENS=800
LARK_LLM_TEMPERATURE=0.2

# ---- B：ReAct agent（多步兜底，SPEC §5.4）----
# 0=关闭（A 失败后直接回引导卡）；启用需 MINIMAX_API_KEY（缺密钥自动降级）
LARK_AGENT_ENABLED=1
LARK_AGENT_MAX_STEPS=6
LARK_AGENT_MODEL=MiniMax-M3.1-Flash
LARK_AGENT_BASE_URL=https://api.minimax.cn/v1
LARK_AGENT_TIMEOUT=60

# ---- 内核依赖（与 CLI / UI 同口径）----
DATA_DIR=./data
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ---- 联网检索（web_search：仅用于外部法律信息）----
# 0=关闭（web_search 一律返回空）；默认开启，无需密钥（fail-soft）
WEB_SEARCH_ENABLED=1
# 可选：自定义检索端点 / 超时（默认 DuckDuckGo HTML，8s）
# WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
# WEB_SEARCH_TIMEOUT=8