# =============================================
# Legal System .gitignore
# 原则：忽略临时/运行时/构建产物；隐藏文件与项目规则（.qoder/ 等）一律纳入版本管理
# 私有仓库策略：.env 允许提交，仅防护密钥类文件
# =============================================

# ---- 临时文件（最广泛）----
*.tmp
*.temp
*.log
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.bak
*.backup
*.old
*.副本

# ---- 构建产物 ----
dist/
build/
out/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
*.whl
node_modules/
.vite/
.cache/

# ---- 密钥类文件（安全红线，始终忽略）----
# 私有仓库允许提交 .env 及其变体（.env.example / .env.local 等）；真实密钥请勿写入版本库
secrets.yaml
secrets.json
credentials.*

# ---- 虚拟环境 ----
.venv/
venv/
ENV/
env/
.conda/

# ---- IDE/编辑器 ----
.vscode/
.idea/
*.sublime-*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user

# ---- 运行时状态（仅显式忽略，不设 .* 一刀切）----
# 项目规则（.qoder/）、环境示例（.env.example）等隐藏文件默认提交
.run/

# ---- 压缩包/安装包 ----
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.dmg
*.pkg
*.deb
*.rpm

# ---- 测试/覆盖率 ----
.coverage
htmlcov/
.pytest_cache/
coverage/
.nyc_output/

# ---- 临时上传/下载 ----
uploads/
downloads/
tmp/
temp/

# ---- 运行时数据 / 生成产物（提交源代码，不提交数据）----
data/
outputs/
*.db

# ---- F-032 代理人上传材料（PII 防护：劳动合同 / 身份证 含敏感信息）----
modules/*/static/agents/
.streamlit/
