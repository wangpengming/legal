# =============================================
# case-intelligence 环境变量模板（复制为 .env 使用，勿提交真实值）
# 对应 shared/config/deploy.yaml 的 env_required / env_optional
# =============================================

# （必需）MiniMax API Key —— ai_engines.yaml 中 env://MINIMAX_API_KEY 引用于此
MINIMAX_API_KEY=

# （可选）MiniMax 模型名，默认 MiniMax-Text-01
MINIMAX_MODEL=

# （可选）UI 认证账号，格式 user:pass,user2:pass2
AUTH_USERS=