# =============================================
# court-doc-generator 后端环境配置示例
# 使用：cp .env.example .env（.env 必须位于 backend/ 目录，
#       因 uvicorn 从 backend/ 启动，pydantic-settings 按 cwd 解析 .env）
# 说明：本模块无真实密钥；密钥类配置（§6.2）严禁写入任何 .env 并提交
# =============================================

# ---- 服务 ----
HOST=0.0.0.0                     # 监听地址：生产 0.0.0.0 对外；本机调试可改 127.0.0.1
PORT=8001                        # 端口（与 shared/config/ports.yaml 注册一致）
DEBUG=false                      # 生产建议 false

# ---- 数据目录（可选）----
# 默认落在模块根 data/（SQLite + workspace）。生产建议指向独立持久化路径：
# DATA_DIR=/var/lib/court-doc-generator

# ---- CORS 白名单（仅开发时跨端口访问前端需要）----
# 生产形态前端由后端同源托管（同端口 8001），无跨域问题，保持默认即可。
CORS_ORIGINS=["http://localhost:18502","http://localhost:3000"]

# ---- 中文字体目录（可选，生产 Linux 关键）----
# docx_to_pdf 按平台候选字体自动探测；Linux 无内置中文字体时，
# 可安装系统包（apt install fonts-noto-cjk）或指定字体所在目录：
# FONT_DIR=/usr/share/fonts/truetype/noto