# 复制为 .env 后填写（.env 不入库；App Secret 等敏感值绝不提交）
# 飞书凭证（docs/01 元数据 + 开放平台密钥）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Base App Token（bascn...）
FEISHU_APP_TOKEN=
# 案件表 / 歌曲表 table_id（docs/01）
FEISHU_TABLE_CASES=
FEISHU_TABLE_SONGS=
# 单用户 API 认证（可忽略：不设置则不启用鉴权）
APP_TOKEN=
# 数据库（默认 sqlite:///<repo>/data/app.db，一般无需覆盖）
# DATABASE_URL=sqlite:////data/app.db